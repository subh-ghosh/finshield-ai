# FinShield AI — Backend Environment Configuration
# Copy this file to .env and fill in your values:
#   cp backend/.env.example backend/.env

# ─────────────────────────────────────────────
# REQUIRED: Google Gemini API Key
# Get yours free at: https://aistudio.google.com
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────
# OPTIONAL: Database (leave blank for SQLite/local mode)
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# OPTIONAL: Planner LLM Settings (defaults below)
# ─────────────────────────────────────────────
PLANNER_LLM_MODEL=gemini-1.5-pro
PLANNER_LLM_TEMPERATURE=0.1
PLANNER_MAX_ITERATIONS=3

# ─────────────────────────────────────────────
# OPTIONAL: API Settings
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
